<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ 设置行（About / Settings 共用） ═══ -->

  <Style Selector="Border.settingRow">
    <Setter Property="Padding" Value="0,12,0,12" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeHighBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Setter.Value>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Border.settingRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
  </Style>

  <!-- ═══ 链接按钮 ═══ -->

  <Style Selector="Button.linkButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.linkButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorDark2}" />
  </Style>

  <!-- 依赖项链接（About 页专用，Padding 更小） -->
  <Style Selector="Button.depLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- ═══ 对话框操作按钮 ═══ -->

  <Style Selector="Button.ActionButton">
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ActionCancel">
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ═══ Accent 强调按钮 ═══ -->

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
  </Style>


  <!-- ═══ 链接卡片按钮（About 页专用） ═══ -->

  <Style Selector="Button.linkCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Setter.Value>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Button.linkCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
  </Style>
  <Style Selector="Button.linkCard:pressed">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
  </Style>

  <!-- ═══ 版本信息徽章 ═══ -->

  <Style Selector="Border.versionBadge">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- ═══ 等宽字体文本 ═══ -->

  <Style Selector="TextBlock.textMono">
    <Setter Property="FontFamily" Value="Cascadia Code, JetBrains Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ═══ 依赖项卡片项 ═══ -->

  <Style Selector="Border.depCardItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Transitions">
      <Setter.Value>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Border.depCardItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
  </Style>

  <!-- ═══ 装饰圆点 ═══ -->

  <Style Selector="Border.badgeDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

</Styles>
