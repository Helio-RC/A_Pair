<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: DI requires parameterized constructor, no public parameterless ctor -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <AssemblyName>SeatFlow</AssemblyName>
    <ApplicationIcon>Assets\icon_with_background.ico</ApplicationIcon>
    <!-- 确定性构建：相同源码 → 相同输出，不因时间/路径变化 -->
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))=./</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\about.json" />
    <EmbeddedResource Include="Data\page_navigation.json" />
    <EmbeddedResource Include="Data\onboarding_config.json" />
    <EmbeddedResource Include="..\RELEASE.md" LogicalName="SeatFlow.Presentation.Avalonia.Data.release.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Lang\Resources.Designer.cs" Condition="!Exists('Lang\Resources.Designer.cs')" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Models\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.337" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="CodeWF.AvaloniaControls" Version="12.1.1.2" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.110-ge826545" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeatFlow.Application\SeatFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Lang\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 编译前获取 git commit short hash，生成 GitCommit.g.cs -->
  <Target Name="GenerateGitCommit" BeforeTargets="BeforeBuild">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown-commit-id</GitCommitHash>
    </PropertyGroup>
    <ItemGroup>
      <_GitCommitLine Include="// Auto-generated by MSBuild target" />
      <_GitCommitLine Include="namespace SeatFlow.Presentation.Avalonia" />
      <_GitCommitLine Include="{" />
      <_GitCommitLine Include="    internal static class GitCommit" />
      <_GitCommitLine Include="    {" />
      <_GitCommitLine Include="        public const string Hash = &quot;$(GitCommitHash.Trim())&quot;%3B" />
      <_GitCommitLine Include="    }" />
      <_GitCommitLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Generated\GitCommit.g.cs" Lines="@(_GitCommitLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Generated\GitCommit.g.cs" />
    </ItemGroup>
  </Target>

  <!-- 编译前从 version.json + git 生成 VersionInfo.g.cs -->
  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateGitCommit">
    <!-- Linux / macOS -->
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/update_version_info.py&quot; --root &quot;$(MSBuildProjectDirectory)/..&quot; --version-json &quot;$(MSBuildProjectDirectory)/../version.json&quot; --output &quot;$(IntermediateOutputPath)Generated/VersionInfo.g.cs&quot;" Condition="'$(OS)' != 'Windows_NT'" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="false" LogStandardErrorAsError="true" />
    <!-- Windows -->
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../scripts/update_version_info.py&quot; --root &quot;$(MSBuildProjectDirectory)/..&quot; --version-json &quot;$(MSBuildProjectDirectory)/../version.json&quot; --output &quot;$(IntermediateOutputPath)Generated/VersionInfo.g.cs&quot;" Condition="'$(OS)' == 'Windows_NT'" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="false" LogStandardErrorAsError="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Generated/VersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- 编译前从所有项目收集 PackageReference 版本号，生成 PackageVersions.g.cs -->
  <Target Name="GeneratePackageVersions" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <!-- 从其他源项目收集 PackageReference -->
    <MSBuild Projects="..\SeatFlow.Infrastructure\SeatFlow.Infrastructure.csproj;..\SeatFlow.Application\SeatFlow.Application.csproj;..\SeatFlow.Core\SeatFlow.Core.csproj" Targets="_GetPackageRefs" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ExtPkgs" />
    </MSBuild>
    <!-- 合并本项目 + 外部项目的 PackageReference -->
    <ItemGroup>
      <_AllPkgs Include="@(PackageReference)" />
      <_AllPkgs Include="@(_ExtPkgs)" />
    </ItemGroup>
    <ItemGroup>
      <_PvLine Include="// Auto-generated — do not edit" />
      <_PvLine Include="using System.Collections.Generic%3B" />
      <_PvLine Include="namespace SeatFlow.Presentation.Avalonia" />
      <_PvLine Include="{" />
      <_PvLine Include="    internal static class PackageVersions" />
      <_PvLine Include="    {" />
      <_PvLine Include="        public static readonly IReadOnlyDictionary%3Cstring%2C string%3E Map =" />
      <_PvLine Include="            new Dictionary%3Cstring%2C string%3E" />
      <_PvLine Include="            {" />
      <_PvLine Include="@(_AllPkgs->'                [&quot;%(Identity)&quot;] = &quot;%(Version)&quot;%2C')" />
      <_PvLine Include="            }%3B" />
      <_PvLine Include="    }" />
      <_PvLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Generated\PackageVersions.g.cs" Lines="@(_PvLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Generated\PackageVersions.g.cs" />
    </ItemGroup>
  </Target>

</Project>
