<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
             x:Class="SeatFlow.Presentation.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <Grid Margin="48,48">
    <DockPanel>
      <!-- Bottom-right: Version footnote -->
      <Border DockPanel.Dock="Bottom" HorizontalAlignment="Right">
        <TextBlock Text="{Binding VersionLabel}" Classes="micro"
                   Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                   Opacity="0.4" />
      </Border>

      <!-- Main content: left-aligned -->
      <StackPanel VerticalAlignment="Center" Spacing="0">

        <!-- Avatar + personalized greeting -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <!-- Real avatar image -->
          <Border IsVisible="{Binding HasUserAvatar}"
                  Width="48" Height="48" CornerRadius="24" ClipToBounds="True">
            <Image Source="{Binding UserAvatar}" Width="48" Height="48"
                   Stretch="UniformToFill" />
          </Border>
          <!-- Initial avatar fallback -->
          <Border IsVisible="{Binding !HasUserAvatar}"
                  Width="48" Height="48" CornerRadius="24"
                  Background="{DynamicResource SystemAccentColor}"
                  Opacity="0.18">
            <TextBlock Text="{Binding UserInitialChar}" FontSize="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemAccentColor}" />
          </Border>

          <TextBlock Text="{Binding PersonalizedGreeting}"
                     FontSize="24" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Logo -->
        <svg:Svg Path="/Assets/icon_with_background.svg"
                 Width="80" Height="80" Stretch="Uniform"
                 Margin="0,32,0,0" />

        <!-- Brand greeting -->
        <TextBlock Text="{Binding Greeting}" Classes="hero"
                   Margin="0,24,0,0" />

        <!-- Subtitle -->
        <TextBlock Text="{Binding Subtitle}" Classes="bodyLarge"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Margin="0,4,0,0" />

        <!-- Accent divider -->
        <Border Width="60" Height="1" Margin="0,20,0,0" Opacity="0.5"
                Background="{DynamicResource SystemAccentColor}" />

        <!-- Hint -->
        <TextBlock Text="{x:Static lang:Resources.Home_Hint}" Classes="caption"
                   Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                   Margin="0,8,0,0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
