<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SeatFlow.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EPPlus" Version="8.6.3" />
    <!-- 覆盖 EPPlus 传递依赖的 System.Security.Cryptography.Xml 10.0.7 (存在 CVE 漏洞) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeatFlow.Contracts\SeatFlow.Contracts.csproj" />
    <ProjectReference Include="..\SeatFlow.Core\SeatFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migration\file_versions.json" />
    <EmbeddedResource Include="Data\field_mappings.json" />
  </ItemGroup>

  <Target Name="_GetPackageRefs" Returns="@(PackageReference)" />

</Project>
