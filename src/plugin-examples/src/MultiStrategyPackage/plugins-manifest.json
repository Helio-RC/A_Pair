{
  "id": "multi-strategy",
  "name": "Multi Strategy Package",
  "version": "1.0.0",
  "author": "SeatFlow Examples",
  "description": "单包包含两个策略，验证双层 manifest 与多策略装配",
  "type": "strategy",
  "plugins": [
    {
      "kind": "strategy",
      "path": "strat-a",
      "manifest": "strat-a/manifest.json",
      "scriptFile": "script.lua",
      "scriptType": "lua"
    },
    {
      "kind": "strategy",
      "path": "strat-b",
      "manifest": "strat-b/manifest.json",
      "scriptFile": "script.lua",
      "scriptType": "lua"
    }
  ]
}
