<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
             xmlns:fic="using:FluentIcons.Avalonia"
             xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
             x:Class="SeatFlow.Presentation.Avalonia.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             x:Name="AboutHost">

  <Design.DataContext>
    <vm:AboutViewModel />
  </Design.DataContext>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Page Title -->
    <Border Grid.Row="0" Margin="0,0,0,24">
      <TextBlock Text="{x:Static lang:Resources.About_Title}" Classes="pageTitle" VerticalAlignment="Center" />
    </Border>

    <!-- Content Area -->
    <Grid Grid.Row="1">
      <!-- Atmospheric accent glow (top-right, behind scroll content) -->
      <Border IsHitTestVisible="False" Opacity="0.03"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="320" Height="320" CornerRadius="160"
              Margin="0,0,24,0">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
        </Border.Background>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0" MaxWidth="680" HorizontalAlignment="Center"
                    Margin="0,0,0,32">

          <!-- Section 1: Hero -->
          <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <svg:Svg Grid.Column="0" Path="/Assets/icon_with_background.svg"
                     Width="100" Height="100" Stretch="Uniform"
                     VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="0">
              <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding VersionDisplay}" Classes="bodySmall"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                         Margin="0,2,0,0" />
              <Separator Margin="0,12,0,12" />
              <TextBlock Text="{Binding Description}" Classes="bodySmall"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
          </Grid>

          <!-- Section 2: Quick Link Cards -->
          <Border Classes="surfaceCard elevationSm radiusMd" Padding="0" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,*,*,*">
              <Button Grid.Column="0" Classes="linkCard"
                      Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                      CommandParameter="{Binding GitHubUrl}"
                      AutomationProperties.Name="{x:Static lang:Resources.About_GitHub}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon Icon="{x:Static ficEnum:Icon.Code}" FontSize="14"
                                  Foreground="{DynamicResource SystemAccentColor}" />
                  <TextBlock Text="{x:Static lang:Resources.About_GitHub}" Classes="bodySmall" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="linkCard"
                      Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                      CommandParameter="{Binding OfficialSiteUrl}"
                      AutomationProperties.Name="{x:Static lang:Resources.About_OfficialSite}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon Icon="{x:Static ficEnum:Icon.Globe}" FontSize="14"
                                  Foreground="{DynamicResource SystemAccentColor}" />
                  <TextBlock Text="{x:Static lang:Resources.About_OfficialSite}" Classes="bodySmall" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="linkCard"
                      Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                      CommandParameter="{Binding DocsUrl}"
                      AutomationProperties.Name="{x:Static lang:Resources.About_Documentation}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon Icon="{x:Static ficEnum:Icon.BookOpen}" FontSize="14"
                                  Foreground="{DynamicResource SystemAccentColor}" />
                  <TextBlock Text="{x:Static lang:Resources.About_Documentation}" Classes="bodySmall" />
                </StackPanel>
              </Button>
              <Button Grid.Column="3" Classes="linkCard"
                      Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                      CommandParameter="{Binding IssuesUrl}"
                      AutomationProperties.Name="{x:Static lang:Resources.About_Issues}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon Icon="{x:Static ficEnum:Icon.Bug}" FontSize="14"
                                  Foreground="{DynamicResource SystemAccentColor}" />
                  <TextBlock Text="{x:Static lang:Resources.About_Issues}" Classes="bodySmall" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Section 3: MIT License Banner -->
          <Border Classes="bgWarning radiusMd" Padding="14" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon Icon="{x:Static ficEnum:Icon.Info}" FontSize="14"
                              Foreground="{StaticResource WarningBrush}"
                              VerticalAlignment="Center" />
              <TextBlock Text="{x:Static lang:Resources.About_MITLicenseWarning}"
                         Classes="bodySmall" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Section 4: System Info Card -->
          <Border Classes="surfaceCard elevationSm radiusMd" Margin="0,16,0,0" Padding="20">
            <StackPanel Spacing="0">
              <TextBlock Text="{x:Static lang:Resources.About_Runtime}"
                         Classes="sectionTitle" Margin="0,0,0,12" />

              <Border Classes="versionBadge" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding VersionDisplay}" Classes="textMono"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="·" Classes="small"
                             Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding BuildDate}" Classes="textMono"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <Separator Margin="0,0,0,4" />

              <Border Classes="settingRow">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{x:Static lang:Resources.About_Framework}"
                             Classes="bodySmall" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding RuntimeVersion}" Classes="bodySmall" HorizontalAlignment="Right"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </DockPanel>
              </Border>
              <Border Classes="settingRow">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{x:Static lang:Resources.About_Avalonia}"
                             Classes="bodySmall" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AvaloniaVersion}" Classes="bodySmall" HorizontalAlignment="Right"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </DockPanel>
              </Border>
              <Border Classes="settingRow" BorderThickness="0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{x:Static lang:Resources.About_License}"
                             Classes="bodySmall" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding License}" Classes="bodySmall" HorizontalAlignment="Right"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Section 5: Dependencies Grid -->
          <Border Classes="surfaceCard elevationSm radiusMd" Margin="0,16,0,0" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="{x:Static lang:Resources.About_Dependencies}"
                         Classes="sectionTitle" />

              <ItemsControl ItemsSource="{Binding Dependencies}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DependencyInfo">
                    <Border Classes="depCardItem" Width="310">
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                Classes="badgeDot" Margin="0,3,10,0"
                                Background="{DynamicResource SystemAccentColor}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                   Classes="bodySmallStrong" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                          <TextBlock Text="{Binding Version}" Classes="small"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                          <TextBlock Text="{Binding License}" Classes="small"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="2" Margin="0,1,0,0">
                          <TextBlock Text="{Binding Purpose}" Classes="caption"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                     VerticalAlignment="Center" />
                          <Button Classes="depLink"
                                  Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                                  CommandParameter="{Binding Url}"
                                  AutomationProperties.Name="{Binding Name}"
                                  VerticalAlignment="Center" Padding="2,0">
                            <fic:FluentIcon Icon="{x:Static ficEnum:Icon.Link}" FontSize="11"
                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Section 6: Footer -->
          <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Text="{Binding Copyright}" Classes="small" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Text="{Binding License}" Classes="micro" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>