<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
             x:Class="SeatFlow.Presentation.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <Grid Margin="48,48">
    <DockPanel>
      <!-- Bottom-right: Version footnote -->
      <Border DockPanel.Dock="Bottom" HorizontalAlignment="Right">
        <TextBlock Text="{Binding VersionLabel}" Classes="micro"
                   Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                   Opacity="0.4" />
      </Border>

      <!-- Top-anchored content, no vertical centering -->
      <StackPanel Spacing="0">
        <!-- Row 1: Avatar + personalized greeting -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border IsVisible="{Binding HasUserAvatar}"
                  Width="48" Height="48" CornerRadius="24" ClipToBounds="True">
            <Image Source="{Binding UserAvatar}" Width="48" Height="48"
                   Stretch="UniformToFill" />
          </Border>
          <Border IsVisible="{Binding !HasUserAvatar}"
                  Width="48" Height="48" CornerRadius="24"
                  Background="{DynamicResource SystemAccentColor}"
                  Opacity="0.18">
            <TextBlock Text="{Binding UserInitialChar}" FontSize="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemAccentColor}" />
          </Border>
          <TextBlock Text="{Binding PersonalizedGreeting}"
                     FontSize="24" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Row 2: Logo + brand text side by side -->
        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,40,0,0">
          <svg:Svg Path="/Assets/icon_with_background.svg"
                   Width="80" Height="80" Stretch="Uniform"
                   VerticalAlignment="Top"
                   Margin="0,6,0,0" />

          <StackPanel Spacing="0">
            <TextBlock Text="{Binding Greeting}" Classes="hero" />
            <TextBlock Text="{Binding Subtitle}" Classes="bodyLarge"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,4,0,0" />
            <Border Width="60" Height="1" Margin="0,14,0,0" Opacity="0.5"
                    Background="{DynamicResource SystemAccentColor}" />
            <TextBlock Text="{x:Static lang:Resources.Home_Hint}" Classes="caption"
                       Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                       Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
