<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:SeatFlow.Presentation.Avalonia.Services"
        xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
        xmlns:conv="using:SeatFlow.Presentation.Avalonia.Converters"
        xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
        x:Class="SeatFlow.Presentation.Avalonia.Views.UpdateDialogWindow"
        x:DataType="vm:UpdateDialogViewModel"
        Width="520" Height="620"
        CanResize="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        Title="{Binding Title}">

  <DockPanel Margin="20,48,20,16">
    <!-- ═══ 底部按钮 + 进度条 ═══ -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="12">
      <!-- 下载进度条 -->
      <ProgressBar IsVisible="{Binding IsDownloading}"
                   Value="{Binding DownloadProgress}"
                   Minimum="0" Maximum="100" Height="6" />

      <!-- 按钮区域（下载中隐藏） -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                  IsVisible="{Binding IsDownloading, Converter={x:Static conv:BoolConverters.Negate}}">
        <Button x:Name="CloseBtn" Classes="ActionCancel"
                Content="{Binding CloseButtonText}" />
        <Button x:Name="ActionBtn" Classes="ActionButton" IsDefault="True"
                Command="{Binding PrimaryActionCommand}"
                Content="{Binding UpdateButtonText}"
                IsVisible="{Binding IsUpdateButtonVisible}"
                IsEnabled="{Binding IsUpdateButtonEnabled}" />
      </StackPanel>
    </StackPanel>

    <!-- ═══ 标题区域 ═══ -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}" Classes="sectionTitle" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Subtitle}" Classes="body"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <!-- ═══ Release Notes（Markdown 渲染） ═══ -->
    <!-- 加载中指示 -->
    <TextBlock IsVisible="{Binding IsLoadingNotes}" Text="Loading..."
               Classes="caption" HorizontalAlignment="Center" Margin="0,20,0,0"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding IsLoadingNotes, Converter={x:Static conv:BoolConverters.Negate}}">
      <ItemsControl ItemsSource="{Binding ReleaseBlocks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:MdBlock">
            <Panel>
              <!-- Title -->
              <TextBlock IsVisible="{Binding IsTitle}" Text="{Binding Text}"
                         FontSize="20" FontWeight="Bold" Margin="0,12,0,2"
                         TextWrapping="Wrap" />
              <!-- Heading -->
              <TextBlock IsVisible="{Binding IsHeading}" Text="{Binding Text}"
                         FontSize="16" FontWeight="SemiBold" Margin="0,10,0,2"
                         TextWrapping="Wrap" />
              <!-- SubHeading -->
              <TextBlock IsVisible="{Binding IsSubHeading}" Text="{Binding Text}"
                         FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2"
                         TextWrapping="Wrap" />
              <!-- ListItem -->
              <StackPanel IsVisible="{Binding IsListItem}"
                          Orientation="Horizontal" Spacing="4" Margin="12,1,0,1">
                <TextBlock Text="·" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{Binding Text}" FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <!-- Paragraph -->
              <TextBlock IsVisible="{Binding IsParagraph}" Text="{Binding Text}"
                         FontSize="13" TextWrapping="Wrap" Margin="0,3,0,3"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <!-- Code -->
              <Border IsVisible="{Binding IsCode}"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                      CornerRadius="4" Padding="12,8" Margin="0,4">
                <TextBlock Text="{Binding Text}" FontSize="12"
                           FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace"
                           TextWrapping="Wrap" />
              </Border>
              <!-- Empty spacer -->
              <Border IsVisible="{Binding IsEmpty}" Height="8" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
